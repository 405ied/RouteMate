{
  "name": "@routemate/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write src test *.json",
    "format:check": "prettier --check src test *.json",
    "test": "node --require ts-node/register --test test/unit.test.ts",
    "test:integration": "node --require ts-node/register --test --test-concurrency=1 test/integration.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  }
}
