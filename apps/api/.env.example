NODE_ENV=development
PORT=3000
# Separate LOGIN principal with inherited routemate_app privileges. Supply through secrets.
ROUTEMATE_RUNTIME_DATABASE_URL=
# Independent randomly generated secrets, each at least 48 characters. No defaults.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=routemate-api
JWT_AUDIENCE=routemate-staff
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=604800
# Empty disables cross-origin browser access; use explicit HTTPS origins in production.
CORS_ORIGINS=
