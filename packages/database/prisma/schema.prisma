model Organization {
  staffSessions      StaffSession[]
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationCode   String             @unique @map("organization_code") @db.VarChar(30)
  name               String             @db.VarChar(255)
  shortName          String?            @map("short_name") @db.VarChar(100)
  organizationType   OrganizationType   @map("organization_type")
  registrationNumber String?            @map("registration_number") @db.VarChar(100)
  email              String?            @db.VarChar(254)
  phone              String?            @db.VarChar(32)
  address            String?            @db.Text
  countryCode        String             @default("NGA") @map("country_code") @db.Char(3)
  status             OrganizationStatus @default(PENDING)
  logoUrl            String?            @map("logo_url") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdById        String?            @map("created_by_id") @db.Uuid
  updatedById        String?            @map("updated_by_id") @db.Uuid

  createdBy                             User?                      @relation("Organization_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy                             User?                      @relation("Organization_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user_organization                     User[]                     @relation("User_organization")
  role_organization                     Role[]                     @relation("Role_organization")
  userRole_organization                 UserRole[]                 @relation("UserRole_organization")
  notification_organization             Notification[]             @relation("Notification_organization")
  auditLog_organization                 AuditLog[]                 @relation("AuditLog_organization")
  securityEvent_organization            SecurityEvent[]            @relation("SecurityEvent_organization")
  organizationSettings_organization     OrganizationSettings?      @relation("OrganizationSettings_organization")
  organizationUnit_organization         OrganizationUnit[]         @relation("OrganizationUnit_organization")
  park_organization                     Park[]                     @relation("Park_organization")
  driver_organization                   Driver[]                   @relation("Driver_organization")
  driverContact_organization            DriverContact[]            @relation("DriverContact_organization")
  driverDocument_organization           DriverDocument[]           @relation("DriverDocument_organization")
  driverStatusHistory_organization      DriverStatusHistory[]      @relation("DriverStatusHistory_organization")
  driverDisciplinaryAction_organization DriverDisciplinaryAction[] @relation("DriverDisciplinaryAction_organization")
  conductor_organization                Conductor[]                @relation("Conductor_organization")
  vehicleOwner_organization             VehicleOwner[]             @relation("VehicleOwner_organization")
  vehicle_organization                  Vehicle[]                  @relation("Vehicle_organization")
  vehicleDocument_organization          VehicleDocument[]          @relation("VehicleDocument_organization")
  vehicleOwnershipHistory_organization  VehicleOwnershipHistory[]  @relation("VehicleOwnershipHistory_organization")
  driverVehicleAssignment_organization  DriverVehicleAssignment[]  @relation("DriverVehicleAssignment_organization")
  vehicleCrewAssignment_organization    VehicleCrewAssignment[]    @relation("VehicleCrewAssignment_organization")
  route_organization                    Route[]                    @relation("Route_organization")
  routeStop_organization                RouteStop[]                @relation("RouteStop_organization")
  parkRoute_organization                ParkRoute[]                @relation("ParkRoute_organization")
  vehicleRouteAssignment_organization   VehicleRouteAssignment[]   @relation("VehicleRouteAssignment_organization")
  vehicleQrCode_organization            VehicleQrCode[]            @relation("VehicleQrCode_organization")
  verificationScan_organization         VerificationScan[]         @relation("VerificationScan_organization")
  journey_organization                  Journey[]                  @relation("Journey_organization")
  journeyEvent_organization             JourneyEvent[]             @relation("JourneyEvent_organization")
  journeyShare_organization             JourneyShare[]             @relation("JourneyShare_organization")
  complaint_organization                Complaint[]                @relation("Complaint_organization")
  complaintUpdate_organization          ComplaintUpdate[]          @relation("ComplaintUpdate_organization")
  incident_organization                 Incident[]                 @relation("Incident_organization")
  incidentEvidence_organization         IncidentEvidence[]         @relation("IncidentEvidence_organization")
  incidentUpdate_organization           IncidentUpdate[]           @relation("IncidentUpdate_organization")
  lostPropertyCase_organization         LostPropertyCase[]         @relation("LostPropertyCase_organization")
  lostPropertyUpdate_organization       LostPropertyUpdate[]       @relation("LostPropertyUpdate_organization")

  @@index([createdById])
  @@index([updatedById])
  @@map("organizations")
}

model OrganizationSettings {
  id                                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                     String   @map("organization_id") @db.Uuid
  allowPublicDriverPhoto             Boolean  @default(false) @map("allow_public_driver_photo")
  allowConductorRegistration         Boolean  @default(false) @map("allow_conductor_registration")
  requireDriverDocumentVerification  Boolean  @default(true) @map("require_driver_document_verification")
  requireVehicleDocumentVerification Boolean  @default(true) @map("require_vehicle_document_verification")
  allowAnonymousBoarding             Boolean  @default(true) @map("allow_anonymous_boarding")
  enableTripSharing                  Boolean  @default(true) @map("enable_trip_sharing")
  enableIncidentReporting            Boolean  @default(true) @map("enable_incident_reporting")
  enableLostProperty                 Boolean  @default(true) @map("enable_lost_property")
  enableLiveTracking                 Boolean  @default(false) @map("enable_live_tracking")
  defaultCountry                     String   @default("NGA") @map("default_country") @db.Char(3)
  defaultTimezone                    String   @default("Africa/Lagos") @map("default_timezone") @db.VarChar(64)
  metadata                           Json?    @db.JsonB
  createdAt                          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById                        String?  @map("created_by_id") @db.Uuid
  updatedById                        String?  @map("updated_by_id") @db.Uuid

  organization Organization @relation("OrganizationSettings_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?        @relation("OrganizationSettings_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy    User?        @relation("OrganizationSettings_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId])
  @@index([organizationId, createdAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("organization_settings")
}

model AdministrativeArea {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String                 @unique @db.VarChar(64)
  name        String                 @db.VarChar(255)
  areaType    AdministrativeAreaType @map("area_type")
  countryCode String                 @map("country_code") @db.Char(3)
  /// Phase 2: GeoJSON MultiPolygon -> geometry(MultiPolygon,4326), GiST index.
  geometry    Unsupported("geometry(MultiPolygon,4326)")?
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?              @map("deleted_at") @db.Timestamptz(6)
  parentId    String?                @map("parent_id") @db.Uuid
  createdById String?                @map("created_by_id") @db.Uuid
  updatedById String?                @map("updated_by_id") @db.Uuid

  parent                              AdministrativeArea?  @relation("AdministrativeArea_parent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy                           User?                @relation("AdministrativeArea_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy                           User?                @relation("AdministrativeArea_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  administrativeArea_parent           AdministrativeArea[] @relation("AdministrativeArea_parent")
  organizationUnit_administrativeArea OrganizationUnit[]   @relation("OrganizationUnit_administrativeArea")
  park_administrativeArea             Park[]               @relation("Park_administrativeArea")

  @@index([parentId])
  @@index([countryCode, areaType, name])
  @@index([createdById])
  @@index([updatedById])
  @@map("administrative_areas")
}

model OrganizationUnit {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  code                 String               @db.VarChar(40)
  name                 String               @db.VarChar(255)
  unitType             OrganizationUnitType @map("unit_type")
  address              String?              @db.Text
  /// Phase 2: GeoJSON Point -> geography(Point,4326), GiST index.
  location             Unsupported("geography(Point,4326)")?
  phone                String?              @db.VarChar(32)
  email                String?              @db.VarChar(254)
  status               RecordStatus         @default(ACTIVE)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?            @map("deleted_at") @db.Timestamptz(6)
  parentUnitId         String?              @map("parent_unit_id") @db.Uuid
  administrativeAreaId String?              @map("administrative_area_id") @db.Uuid
  createdById          String?              @map("created_by_id") @db.Uuid
  updatedById          String?              @map("updated_by_id") @db.Uuid

  parentUnit                  OrganizationUnit?   @relation("OrganizationUnit_parentUnit", fields: [organizationId, parentUnitId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  administrativeArea          AdministrativeArea? @relation("OrganizationUnit_administrativeArea", fields: [administrativeAreaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization                Organization        @relation("OrganizationUnit_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy                   User?               @relation("OrganizationUnit_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy                   User?               @relation("OrganizationUnit_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organizationUnit_parentUnit OrganizationUnit[]  @relation("OrganizationUnit_parentUnit")
  park_organizationUnit       Park[]              @relation("Park_organizationUnit")
  userRole_organizationUnit   UserRole[]          @relation("UserRole_organizationUnit")
  driver_organizationUnit     Driver[]            @relation("Driver_organizationUnit")

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, createdAt])
  @@index([organizationId, parentUnitId])
  @@index([administrativeAreaId])
  @@index([createdById])
  @@index([updatedById])
  @@map("organization_units")
}

model Park {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  parkCode             String       @unique @map("park_code") @db.VarChar(30)
  name                 String       @db.VarChar(255)
  address              String?      @db.Text
  /// Phase 2: GeoJSON Point -> geography(Point,4326), GiST index.
  location             Unsupported("geography(Point,4326)")?
  parkType             ParkType     @default(MOTOR_PARK) @map("park_type")
  status               RecordStatus @default(ACTIVE)
  capacity             Int?
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?    @map("deleted_at") @db.Timestamptz(6)
  organizationUnitId   String       @map("organization_unit_id") @db.Uuid
  administrativeAreaId String?      @map("administrative_area_id") @db.Uuid
  managerUserId        String?      @map("manager_user_id") @db.Uuid
  createdById          String?      @map("created_by_id") @db.Uuid
  updatedById          String?      @map("updated_by_id") @db.Uuid

  organizationUnit              OrganizationUnit           @relation("Park_organizationUnit", fields: [organizationId, organizationUnitId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  administrativeArea            AdministrativeArea?        @relation("Park_administrativeArea", fields: [administrativeAreaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  managerUser                   User?                      @relation("Park_managerUser", fields: [managerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization                  Organization               @relation("Park_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy                     User?                      @relation("Park_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy                     User?                      @relation("Park_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userRole_park                 UserRole[]                 @relation("UserRole_park")
  driver_primaryPark            Driver[]                   @relation("Driver_primaryPark")
  driverDisciplinaryAction_park DriverDisciplinaryAction[] @relation("DriverDisciplinaryAction_park")
  conductor_primaryPark         Conductor[]                @relation("Conductor_primaryPark")
  vehicle_primaryPark           Vehicle[]                  @relation("Vehicle_primaryPark")
  parkRoute_park                ParkRoute[]                @relation("ParkRoute_park")
  vehicleRouteAssignment_park   VehicleRouteAssignment[]   @relation("VehicleRouteAssignment_park")
  journey_boardingPark          Journey[]                  @relation("Journey_boardingPark")
  complaint_park                Complaint[]                @relation("Complaint_park")
  incident_park                 Incident[]                 @relation("Incident_park")
  lostPropertyCase_park         LostPropertyCase[]         @relation("LostPropertyCase_park")

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, organizationUnitId])
  @@index([administrativeAreaId])
  @@index([managerUserId])
  @@index([createdById])
  @@index([updatedById])
  @@map("parks")
}

/// A null organizationId is reserved for platform operators. Tenant staff belong to one organization. Phase 2 must enforce actor/grant tenant scope, including platform exceptions; these nullable global references use UUID foreign keys.
model User {
  staffSessions       StaffSession[]
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String?    @map("organization_id") @db.Uuid
  firstName           String     @map("first_name") @db.VarChar(100)
  lastName            String     @map("last_name") @db.VarChar(100)
  email               String?    @db.VarChar(254)
  phone               String?    @db.VarChar(32)
  passwordHash        String?    @map("password_hash") @db.Text
  externalAuthSubject String?    @unique @map("external_auth_subject") @db.VarChar(255)
  status              UserStatus @default(INVITED)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt     DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdById         String?    @map("created_by_id") @db.Uuid
  updatedById         String?    @map("updated_by_id") @db.Uuid

  organization                       Organization?              @relation("User_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy                          User?                      @relation("User_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy                          User?                      @relation("User_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  park_managerUser                   Park[]                     @relation("Park_managerUser")
  userRole_user                      UserRole[]                 @relation("UserRole_user")
