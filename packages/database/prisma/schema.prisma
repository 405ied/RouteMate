  @@index([updatedById])
  @@index([authorPassengerId])
  @@index([authorSessionId])
  @@index([organizationId, lostPropertyCaseId, createdAt], map: "lost_property_updates_organization_id_lost__aa3b475bfd31")
  @@map("lost_property_updates")
}

/// Typed recipient foreign keys replace unsafe polymorphic recipientId. Phase 2 CHECK exactly one recipient matching recipientType, and tenant user scope. Null organization is platform-originated. Workers use atomic claims/leases; never put secrets in metadata.
model Notification {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String?                   @map("organization_id") @db.Uuid
  recipientType        NotificationRecipientType @map("recipient_type")
  channel              NotificationChannel
  notificationType     NotificationType          @map("notification_type")
  title                String                    @db.VarChar(255)
  message              String                    @db.Text
  metadata             Json?                     @db.JsonB
  status               NotificationStatus        @default(PENDING)
  scheduledAt          DateTime                  @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  sentAt               DateTime?                 @map("sent_at") @db.Timestamptz(6)
  deliveredAt          DateTime?                 @map("delivered_at") @db.Timestamptz(6)
  readAt               DateTime?                 @map("read_at") @db.Timestamptz(6)
  attemptCount         Int                       @default(0) @map("attempt_count")
  nextAttemptAt        DateTime?                 @map("next_attempt_at") @db.Timestamptz(6)
  lockedUntil          DateTime?                 @map("locked_until") @db.Timestamptz(6)
  lastError            String?                   @map("last_error") @db.Text
  providerMessageId    String?                   @map("provider_message_id") @db.VarChar(255)
  idempotencyKey       String                    @unique @map("idempotency_key") @db.VarChar(128)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipientUserId      String?                   @map("recipient_user_id") @db.Uuid
  recipientPassengerId String?                   @map("recipient_passenger_id") @db.Uuid

  organization       Organization? @relation("Notification_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipientUser      User?         @relation("Notification_recipientUser", fields: [recipientUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipientPassenger Passenger?    @relation("Notification_recipientPassenger", fields: [recipientPassengerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId])
  @@index([status, scheduledAt, nextAttemptAt])
  @@index([recipientUserId, readAt, createdAt(sort: Desc)])
  @@index([recipientPassengerId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Append-only business audit. Phase 2 revoke UPDATE/DELETE for application role and enforce immutable trigger. Null org is a platform action. Redact passwords, bearer tokens, sensitive ID/contact/media data before persistence.
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  /// Extensible action code, e.g. DRIVER_SUSPENDED; not a lifecycle status.
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(100)
  /// Polymorphic historical identifier intentionally has no FK.
  entityId       String?  @map("entity_id") @db.Uuid
  previousData   Json?    @map("previous_data") @db.JsonB
  newData        Json?    @map("new_data") @db.JsonB
  ipHash         String?  @map("ip_hash") @db.VarChar(128)
  deviceHash     String?  @map("device_hash") @db.VarChar(128)
  requestId      String?  @map("request_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorUserId    String?  @map("actor_user_id") @db.Uuid

  organization Organization? @relation("AuditLog_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUser    User?         @relation("AuditLog_actorUser", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorUserId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId, createdAt(sort: Desc)], map: "audit_logs_organization_id_entity_type_enti_8c11e43bc46b")
  @@map("audit_logs")
}

/// Append-only security audit; nullable identities permit unknown login/QR attempts. Phase 2 immutable permissions/triggers and retention policy.
model SecurityEvent {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String?           @map("organization_id") @db.Uuid
  eventType          SecurityEventType @map("event_type")
  severity           Severity          @default(LOW)
  ipHash             String?           @map("ip_hash") @db.VarChar(128)
  deviceHash         String?           @map("device_hash") @db.VarChar(128)
  /// HMAC of submitted identity for failed/unknown logins, not raw credentials.
  subjectHash        String?           @map("subject_hash") @db.VarChar(128)
  userAgentSummary   String?           @map("user_agent_summary") @db.VarChar(512)
  requestId          String?           @map("request_id") @db.VarChar(128)
  metadata           Json?             @db.JsonB
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  userId             String?           @map("user_id") @db.Uuid
  passengerId        String?           @map("passenger_id") @db.Uuid
  passengerSessionId String?           @map("passenger_session_id") @db.Uuid

  organization     Organization?     @relation("SecurityEvent_organization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user             User?             @relation("SecurityEvent_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  passenger        Passenger?        @relation("SecurityEvent_passenger", fields: [passengerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  passengerSession PassengerSession? @relation("SecurityEvent_passengerSession", fields: [passengerSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([passengerId])
  @@index([passengerSessionId])
  @@index([organizationId, eventType, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("security_events")
}

/// Platform-only, non-secret configuration; store secret references in a vault instead of credentials here. Phase 2 validate JSON type against valueType.
model SystemSetting {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique @db.VarChar(150)
  value       Json             @db.JsonB
  valueType   SettingValueType @default(JSON) @map("value_type")
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?          @map("updated_by_id") @db.Uuid

  updatedBy User? @relation("SystemSetting_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([updatedById])
  @@map("system_settings")
}

/// Refresh tokens are stored only as SHA-256 hashes. RLS requires tenant AND user context.
model StaffSession {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  refreshTokenHash String       @map("refresh_token_hash") @db.VarChar(64)
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "staff_sessions_user_fk")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "staff_sessions_organization_fk")
  @@index([organizationId, userId])
  @@index([expiresAt])
  @@map("staff_sessions")
}
