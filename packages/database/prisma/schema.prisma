  previousStatus     LostPropertyStatus? @map("previous_status")
  newStatus          LostPropertyStatus? @map("new_status")
  comment            String?             @db.Text
  isInternal         Boolean             @default(true) @map("is_internal")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  lostPropertyCaseId String              @map("lost_property_case_id") @db.Uuid
  updatedById        String?             @map("updated_by_id") @db.Uuid
  authorPassengerId  String?             @map("author_passenger_id") @db.Uuid
  authorSessionId    String?             @map("author_session_id") @db.Uuid

  lostPropertyCase LostPropertyCase  @relation("LostPropertyUpdate_lostPropertyCase", fields: [organizationId, lostPropertyCaseId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy        User?             @relation("LostPropertyUpdate_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  authorPassenger  Passenger?        @relation("LostPropertyUpdate_authorPassenger", fields: [authorPassengerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
